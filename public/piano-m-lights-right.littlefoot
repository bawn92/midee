/*
<metadata description="Piano M right board lights" target="LUMI Keys" tags="MIDI;Light;" insertModes="false">
</metadata>

Theme lights for the right ROLI Piano M or LUMI board. Drop this file on the right board in ROLI Dashboard. It is the same lights as the left file, with this board fixed as board 1.

Piano Club sends one shared stream. CC 23 is the lowest MIDI note of the
whole window, the same value on every board. This file lights only the 24
keys that belong to board 1: that lowest note, plus 24.
Notes outside those 24 keys are ignored. The same note-on can arrive twice.

Each lit key stores the colour of that one note. CC 20, 21, and 22 are a
complete red, green, and blue triplet on channel 12 or 13, sent immediately
before that note's note-on. The key changes colour only when all three have
arrived, so a torn triplet cannot mix two notes. A note-off on those
channels clears the key. Notes and controllers on any other channel are
ignored, so playing the board cannot wipe or recolour a guide.

The colour table is 24 keys, not 128 notes. A 128-int table is larger than
this block's globals and overwrites the colour registers, which is why keys
used to light in unrelated colours. #heapsize is the shared host heap, in
bytes. It is not the colour table.

Playing and the octave buttons stay with the factory key handler. This
program does not define a button handler, so it cannot move the octave
from a button. The key callbacks below only remember which key is held.
They do not change the colour and they do not transmit notes. A held key
stays the note colour.

If this board still plays the same notes as the left board, the load
below raises its octave when the DNA topology is unset. Press both
octave buttons to reset an octave the factory handler has shifted.
Holding all three top buttons restores the factory program and removes
these lights.

Channels 12 and 13 are the left and right hands. CC 20/21/22 are red,
green, and blue, 0–127, expanded with (value * 255) / 127. CC 23 on
channel 12 or 13 is the window lowest note. CC 121 and CC 123 clear the
guide notes.
*/

#heapsize: 128

const int keysPerBlock = 24;
const int boardIndex = 1;
const int midiNoteOff = 0x8;
const int midiNoteOn = 0x9;
const int midiCC = 0xB;

int baseNote;
int leftR;
int leftG;
int leftB;
int leftGot;
int rightR;
int rightG;
int rightB;
int rightGot;
int colorFor[24];
int downKey[24];

const int configOctave = 4;
const int configTopology = 8;

void matchFirmwareOctave() {
    // Config 8 is the DNA octave topology. Zero means this board is still
    // in the same octave as the left board, which is what a factory reset
    // leaves behind. Two octaves per board to the right puts the right
    // board 24 semitones higher. A topology that is already set means the
    // firmware is offsetting, so the octave stays where it is.
    // If topology stays 0 while the firmware still offsets, this adds
    // another two octaves. Set Octave back to 0 in ROLI Dashboard.
    // Loading this file again sets that octave whenever topology is 0.
    int topology = getLocalConfig(configTopology);
    if (topology == 0) setLocalConfig(configOctave, boardIndex * 2);
}

int component(int value) {
    return (value * 255) / 127;
}

int keyFrom(int note) {
    int origin = baseNote + boardIndex * keysPerBlock;
    return note - origin;
}

void clearNotes() {
    for (int i = 0; i < keysPerBlock; i = i + 1) colorFor[i] = 0;
}

void clearDown() {
    for (int i = 0; i < keysPerBlock; i = i + 1) downKey[i] = 0;
}

void markDown(int keyIndex) {
    if (keyIndex >= 0 && keyIndex < keysPerBlock) downKey[keyIndex] = 1;
}

void markUp(int keyIndex) {
    if (keyIndex >= 0 && keyIndex < keysPerBlock) downKey[keyIndex] = 0;
}

void remember(int channel, int cc, int value) {
    if (channel == 11) {
        if (leftGot == 7) leftGot = 0;
        if (cc == 20) leftR = value;
        if (cc == 21) leftG = value;
        if (cc == 22) leftB = value;
        if (cc == 20) leftGot = leftGot | 1;
        if (cc == 21) leftGot = leftGot | 2;
        if (cc == 22) leftGot = leftGot | 4;
        return;
    }
    if (rightGot == 7) rightGot = 0;
    if (cc == 20) rightR = value;
    if (cc == 21) rightG = value;
    if (cc == 22) rightB = value;
    if (cc == 20) rightGot = rightGot | 1;
    if (cc == 21) rightGot = rightGot | 2;
    if (cc == 22) rightGot = rightGot | 4;
}

void initialise() {
    // Factory handler sends the notes. Do not turn clustering on: that
    // replaces the factory octave map and both boards then play the same notes.
    setUseDefaultKeyHandler(true, false);
    matchFirmwareOctave();
    baseNote = 60;
    leftR = 0;
    leftG = 0;
    leftB = 0;
    leftGot = 0;
    rightR = 0;
    rightG = 0;
    rightB = 0;
    rightGot = 0;
    clearNotes();
    clearDown();
}

void handleMIDI(int byte0, int byte1, int byte2) {
    int channel = byte0 & 0x0F;
    int status = (byte0 >> 4) & 0x0F;

    if (status == midiCC) {
        if (channel != 11 && channel != 12) return;
        if (byte1 == 123 || byte1 == 121) {
            clearNotes();
            return;
        }
        if (byte1 == 23) {
            if (baseNote != byte2) {
                baseNote = byte2;
                clearNotes();
            }
            return;
        }
        if (byte1 >= 20 && byte1 <= 22) remember(channel, byte1, component(byte2));
        return;
    }

    // Factory key echo is another channel. It must not repaint or clear a guide.
    if (channel != 11 && channel != 12) return;
    if (byte1 < 0 || byte1 > 127) return;
    int key = keyFrom(byte1);
    if (key < 0 || key >= keysPerBlock) return;

    if (status == midiNoteOn && byte2 > 0) {
        int ready = leftGot;
        int r = leftR;
        int g = leftG;
        int b = leftB;
        if (channel == 12) {
            ready = rightGot;
            r = rightR;
            g = rightG;
            b = rightB;
        }
        if (ready == 7) colorFor[key] = r * 65536 + g * 256 + b;
        return;
    }

    if (status == midiNoteOff || (status == midiNoteOn && byte2 == 0)) colorFor[key] = 0;
}

// Observe only. These callbacks do not transmit notes or change colours.
void keyStrike(int keyIndex, int unused, int velocity) {
    if (velocity < 0) keyIndex = unused;
    markDown(keyIndex);
}

void keyPress(int keyIndex, int aftertouch, int velocity) {
    if (velocity < 0) keyIndex = aftertouch;
    markDown(keyIndex);
}

void keyLift(int keyIndex, int unused, int velocity) {
    if (velocity < 0) keyIndex = unused;
    markUp(keyIndex);
}

void repaint() {
    for (int key = 0; key < keysPerBlock; key = key + 1) {
        int origin = baseNote + boardIndex * keysPerBlock;
        int note = origin + key;
        int packed = 0;
        if (note >= origin && note < origin + keysPerBlock) packed = colorFor[key];
        int r = 0;
        int g = 0;
        int b = 0;
        if (packed != 0) {
            r = packed / 65536;
            g = (packed - r * 65536) / 256;
            b = packed - r * 65536 - g * 256;
        }
        fillPixel(makeARGB(255, r, g, b), key, 0);
    }
}
