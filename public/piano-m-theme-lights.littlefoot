/*
<metadata description="Piano M theme lights" target="LUMI Keys" tags="MIDI;Light;" insertModes="false">
</metadata>

Theme lights for the ROLI Piano M, including boards snapped together with
the DNA connectors. Two boards are one 48-key keyboard on a single USB MIDI
port. Three are 72. Each board runs its own copy of this script. fillPixel
only reaches that board's 24 keys, so drop this file on every board.

Reload in ROLI Dashboard:
  1. Download piano-m-theme-lights.littlefoot from Key Lights setup help.
  2. Drag that file onto each Piano M. Drop it on top of the Synthesia script
     or any older piano-m-theme-lights.littlefoot so Dashboard replaces it.
  3. The same file goes on every snapped board. A factory reset restores the
     stock firmware.

Why a board index is required:
  getClusterXpos() is a DNA-grid coordinate, not a board number, and on a
  custom program it stays 0 on every board until clustering is enabled. Using
  it raw makes both boards paint the same 24 notes. This script turns
  clustering on, divides that coordinate by the width of one board, and also
  reads the distance from the USB master. A non-master board that still looks
  like index 0 stays dark instead of mirroring. Playing already used the
  factory key handler, which is why the notes were right while the lights were
  not.

If the right board is dark, or it still matches the left board:
  Hold Octave up (the right octave button) on that board while this script
  loads, or hold Octave up for about a second. One cyan key means board 0
  (left). Two cyan keys mean the board to its right. The choice is saved on
  the board. Hold Octave down while the script loads to forget it and try
  automatic placement again.

Light modes, same controls as the stock LUMI firmware:
  Tap Power/Mode to cycle. The octave arrows still shift octave.
  Hold Power/Mode and tap an octave arrow to cycle as well. That arrow also
  shifts the octave, so tap the other way if you only wanted the mode.
  1 Piano Club guide (incoming notes and pressed keys)
  2 Rainbow backlight
  3 Rose on the left half, honey on the right half
  4 Pressed keys
  5 Off
  Incoming guide notes stay on top in modes 1–4. The mode is saved per board
  and sent to the other boards in the cluster.

Channels 12 and 13 are the left and right hands. CC 20/21/22 are red, green,
and blue. CC 23 on channel 12 is the shared lowest MIDI note (factory 60).
CC 24 on channel 12 is the light mode, so a change on one board can follow
on the other. CC 121 and CC 123 clear the guide notes.
*/

const int keysPerBlock = 24;
const int midiNoteOff = 0x8;
const int midiNoteOn = 0x9;
const int midiCC = 0xB;
const int colorOff = 0xFF000000;
const int configIndex = 64;
const int configMode = 65;
const int configManual = 66;
const int modeCC = 24;
const int maxBoard = 2;

int baseNote;
int leftR;
int leftG;
int leftB;
int rightR;
int rightG;
int rightB;
int handFor[128];
int downKey[24];
int lightMode;
int savedIndex;
int manualSet;
int bootAt;
int modeDownAt;
int modeArrows;
int octaveUpAt;
int octaveUpArmed;
int modeFlashUntil;
int indexFlashUntil;
int indexFlashCount;
int clusterPoke;
int shadeR;
int shadeG;
int shadeB;

int component(int value) {
    return (value * 255) / 127;
}

int handFromChannel(int channel) {
    if (channel == 1 || channel == 11) return 1;
    if (channel >= 2 && channel <= 5) return 1;
    if (channel == 6 || channel == 12) return 2;
    if (channel >= 7 && channel <= 10) return 2;
    return 0;
}

void clearNotes() {
    for (int i = 0; i < 128; i = i + 1) handFor[i] = 0;
}

void clearDown() {
    for (int i = 0; i < keysPerBlock; i = i + 1) downKey[i] = 0;
}

void rememberMode() {
    setLocalConfig(configMode, lightMode);
}

void rememberIndex() {
    setLocalConfig(configIndex, savedIndex);
    setLocalConfig(configManual, manualSet);
}

void publishMode() {
    sendCC(11, modeCC, lightMode);
    int count = getNumBlocksInCurrentCluster();
    if (count > 4) count = 4;
    int self = getClusterIndex();
    for (int i = 0; i < count; i = i + 1) {
        if (i != self) {
            sendMessageToBlock(getBlockIdForBlockInCluster(i), 1, lightMode, 0);
        }
    }
}

void adoptMode(int next, int broadcast) {
    if (next < 0 || next > 4) return;
    if (next == lightMode) return;
    lightMode = next;
    rememberMode();
    modeFlashUntil = getMillisecondCounter() + 320;
    if (broadcast != 0) publishMode();
}

void cycleMode(int step) {
    int next = lightMode + step;
    if (next > 4) next = 0;
    if (next < 0) next = 4;
    adoptMode(next, 1);
}

void toggleIndex() {
    int current = 0;
    if (manualSet == 1) current = savedIndex;
    int next = 1;
    if (current == 1) next = 2;
    if (current >= 2) next = 0;
    if (manualSet == 0) next = 1;
    savedIndex = next;
    manualSet = 1;
    rememberIndex();
    indexFlashCount = savedIndex + 1;
    indexFlashUntil = getMillisecondCounter() + 700;
}

void clearManualIndex() {
    manualSet = 0;
    savedIndex = 0;
    rememberIndex();
    indexFlashCount = 1;
    indexFlashUntil = getMillisecondCounter() + 700;
}

// DNA-grid position divided by one board's width. A single block is index 0.
// A non-master block that still reports 0 stays unknown (-1) so it cannot
// mirror the left board.
int detectIndex() {
    int topo = getNumBlocksInTopology();
    int count = getNumBlocksInCurrentCluster();
    int width = getClusterWidth();
    int xpos = getClusterXpos();
    int dist = getHorizontalDistFromMaster();
    int master = 0;
    if (isMasterBlock()) master = 1;
    if (topo < 1) topo = 1;
    if (count < 1) count = 1;
    if (width < 1) width = 1;

    int unit = 1;
    if (count > 1 && width > count && (width / count) * count == width) {
        unit = width / count;
    }
    if (unit < 1) unit = 1;

    int many = 0;
    if (topo > 1 || count > 1 || width > unit) many = 1;
    if (many == 0) return 0;

    if (master == 0 && dist > 0) {
        int fromDist = dist / unit;
        if (fromDist < 1) fromDist = 1;
        if (fromDist > maxBoard) fromDist = maxBoard;
        return fromDist;
    }
    if (xpos > 0) {
        int fromX = xpos / unit;
        if (fromX < 1) fromX = 1;
        if (fromX > maxBoard) fromX = maxBoard;
        return fromX;
    }
    if (master == 1 && xpos == 0) return 0;
    return -1;
}

int boardIndex() {
    if (manualSet == 1) return savedIndex;
    return detectIndex();
}

void setRainbow(int key) {
    int band = key / 4;
    int step = key - band * 4;
    int rise = step * 50;
    int fall = 150 - step * 50;
    shadeR = 0;
    shadeG = 0;
    shadeB = 0;
    if (band == 0) {
        shadeR = 160;
        shadeG = rise;
    }
    if (band == 1) {
        shadeR = fall;
        shadeG = 160;
    }
    if (band == 2) {
        shadeG = 160;
        shadeB = rise;
    }
    if (band == 3) {
        shadeG = fall;
        shadeB = 160;
    }
    if (band == 4) {
        shadeR = rise;
        shadeB = 160;
    }
    if (band == 5) {
        shadeR = 160;
        shadeB = fall;
    }
}

void markDown(int keyIndex) {
    if (keyIndex >= 0 && keyIndex < keysPerBlock) downKey[keyIndex] = 1;
}

void markUp(int keyIndex) {
    if (keyIndex >= 0 && keyIndex < keysPerBlock) downKey[keyIndex] = 0;
}

void initialise() {
    // Factory handler keeps touch, octave buttons, and outgoing notes.
    setUseDefaultKeyHandler(true, false);
    setClusteringActive(true);
    baseNote = 60;
    leftR = 0;
    leftG = 0;
    leftB = 255;
    rightR = 0;
    rightG = 255;
    rightB = 0;
    lightMode = 0;
    savedIndex = 0;
    manualSet = 0;
    modeDownAt = 0;
    modeArrows = 0;
    octaveUpAt = 0;
    octaveUpArmed = 0;
    modeFlashUntil = 0;
    indexFlashUntil = 0;
    indexFlashCount = 0;
    clusterPoke = 0;
    clearNotes();
    clearDown();

    manualSet = getLocalConfig(configManual);
    savedIndex = getLocalConfig(configIndex);
    lightMode = getLocalConfig(configMode);
    setLocalConfigItemRange(configIndex, 0, maxBoard);
    setLocalConfigActiveState(configIndex, true, true);
    setLocalConfigItemRange(configMode, 0, 4);
    setLocalConfigActiveState(configMode, true, true);
    setLocalConfigItemRange(configManual, 0, 1);
    setLocalConfigActiveState(configManual, true, true);
    if (manualSet != 1) manualSet = 0;
    if (savedIndex < 0 || savedIndex > maxBoard) savedIndex = 0;
    if (lightMode < 0 || lightMode > 4) lightMode = 0;
    bootAt = getMillisecondCounter();
}

void handleMIDI(int byte0, int byte1, int byte2) {
    int channel = byte0 & 0x0F;
    int status = (byte0 >> 4) & 0x0F;

    if (status == midiCC) {
        if (byte1 == 123 || byte1 == 121) {
            clearNotes();
            return;
        }
        if (byte1 == modeCC && (channel == 11 || channel == 12)) {
            adoptMode(byte2, 0);
            return;
        }
        if (byte1 == 23 && (channel == 11 || channel == 12)) {
            baseNote = byte2;
            return;
        }
        if (byte1 >= 20 && byte1 <= 22 && (channel == 11 || channel == 12)) {
            int value = component(byte2);
            if (channel == 11) {
                if (byte1 == 20) leftR = value;
                if (byte1 == 21) leftG = value;
                if (byte1 == 22) leftB = value;
            } else {
                if (byte1 == 20) rightR = value;
                if (byte1 == 21) rightG = value;
                if (byte1 == 22) rightB = value;
            }
        }
        return;
    }

    if (byte1 < 0 || byte1 > 127) return;
    int hand = handFromChannel(channel);
    if (status == midiNoteOn && byte2 > 0) {
        if (hand != 0) handFor[byte1] = hand;
    } else if (status == midiNoteOff || (status == midiNoteOn && byte2 == 0)) {
        handFor[byte1] = 0;
    }
}

void handleMessage(int kind, int value, int unused) {
    if (kind == 1) adoptMode(value, 0);
}

// Button 0 is Power/Mode. Button 1 is Octave down. Button 2 is Octave up.
// Stock LUMI firmware cycles light modes from Power/Mode. Octave arrows keep
// shifting octave through the factory handler.
void handleButtonDown(int index) {
    int now = getMillisecondCounter();
    if (index == 0) {
        modeDownAt = now;
        modeArrows = 0;
    }
    if (index == 1) {
        if (modeDownAt != 0) {
            cycleMode(-1);
            modeArrows = 1;
        } else {
            if (now - bootAt < 1500) clearManualIndex();
        }
    }
    if (index == 2) {
        octaveUpAt = now;
        octaveUpArmed = 1;
        if (modeDownAt != 0) {
            cycleMode(1);
            modeArrows = 1;
            octaveUpArmed = 0;
        } else {
            if (now - bootAt < 1500) {
                toggleIndex();
                octaveUpArmed = 0;
            }
        }
    }
}

void handleButtonUp(int index) {
    int now = getMillisecondCounter();
    if (index == 0) {
        if (modeArrows == 0 && modeDownAt != 0 && now - modeDownAt < 600 && now - modeDownAt >= 0) {
            cycleMode(1);
        }
        modeDownAt = 0;
    }
    if (index == 2) {
        if (octaveUpArmed == 1 && octaveUpAt != 0 && now - octaveUpAt >= 1000) toggleIndex();
        octaveUpAt = 0;
        octaveUpArmed = 0;
    }
}

void keyStrike(int keyIndex, int unused, int velocity) {
    markDown(keyIndex);
}

void keyPress(int keyIndex, int aftertouch, int velocity) {
    markDown(keyIndex);
}

void keyLift(int keyIndex, int unused, int velocity) {
    markUp(keyIndex);
}

void repaint() {
    int now = getMillisecondCounter();
    if (now - clusterPoke > 2000) {
        clusterPoke = now;
        setClusteringActive(true);
    }

    int index = boardIndex();
    int flashingIndex = 0;
    if (now < indexFlashUntil) flashingIndex = 1;
    int flashingMode = 0;
    if (now < modeFlashUntil) flashingMode = 1;

    for (int key = 0; key < keysPerBlock; key = key + 1) {
        int r = 0;
        int g = 0;
        int b = 0;
        int note = -1;
        if (index >= 0) note = baseNote + index * keysPerBlock + key;

        if (flashingIndex == 1) {
            if (key < indexFlashCount) fillPixel(makeARGB(255, 60, 190, 255), key, 0);
            else fillPixel(colorOff, key, 0);
        } else {
            if (lightMode != 4 && index >= 0) {
                if (lightMode == 1) {
                    setRainbow(key);
                    r = shadeR;
                    g = shadeG;
                    b = shadeB;
                }
                if (lightMode == 2) {
                    if (key < 12) {
                        r = leftR / 2;
                        g = leftG / 2;
                        b = leftB / 2;
                    } else {
                        r = rightR / 2;
                        g = rightG / 2;
                        b = rightB / 2;
                    }
                }
            }

            int guided = 0;
            if (index >= 0 && note >= 0 && note < 128) guided = handFor[note];
            int held = downKey[key];

            if (held == 1 && guided == 0 && lightMode != 4) {
                int useRight = 1;
                if (index >= 0 && note < 60) useRight = 0;
                if (index < 0 && key < 12) useRight = 0;
                if (useRight == 0) {
                    r = leftR / 2;
                    g = leftG / 2;
                    b = leftB / 2;
                } else {
                    r = rightR / 2;
                    g = rightG / 2;
                    b = rightB / 2;
                }
            }

            if (guided == 1 && lightMode != 4) {
                r = leftR;
                g = leftG;
                b = leftB;
            }
            if (guided == 2 && lightMode != 4) {
                r = rightR;
                g = rightG;
                b = rightB;
            }
            if (guided != 0 && held == 1 && lightMode != 4) {
                r = r + (255 - r) / 2;
                g = g + (255 - g) / 2;
                b = b + (255 - b) / 2;
            }

            if (flashingMode == 1 && guided == 0 && held == 0) {
                r = 150;
                g = 120;
                b = 70;
            }
            fillPixel(makeARGB(255, r, g, b), key, 0);
        }
    }
}
