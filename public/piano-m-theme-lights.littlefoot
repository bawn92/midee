/*
<metadata description="Piano M theme lights" target="LUMI Keys" tags="MIDI;Light;" insertModes="false">
</metadata>

Theme lights for the ROLI Piano M, including boards snapped together with
the DNA connectors. Two boards are one 48-key keyboard on a single USB MIDI
port. Each board runs this script on its own and has 24 keys.

Reload this file in ROLI Dashboard:
  1. Download piano-m-theme-lights.littlefoot from Key Lights setup help.
  2. Open ROLI Dashboard and drag that file onto the Piano M.
  3. If the Synthesia script or an older piano-m-theme-lights.littlefoot is
     already loaded, drop this file on top of it so Dashboard replaces it.
  4. The same script belongs on every snapped board. Do not load a different
     script per board.
A factory reset in ROLI Dashboard restores the stock firmware.

Channels 12 and 13 are still the left and right hands. The older finger
channels count too: 2–6 and 12 are the left hand, 7–11 and 13 are the right
hand. Colours are no longer the fixed blue and green from the Synthesia script.

The app sends the active scene on these control changes. Each value is 0–127:

  channel 12, CC 20 / 21 / 22   left hand red / green / blue
  channel 13, CC 20 / 21 / 22   right hand red / green / blue
  channel 12, CC 23             MIDI note of the shared lowest key (factory: 60)

CC 23 is one note for the whole keyboard. This block adds 24 times its
horizontal place in the DNA cluster (getClusterXpos: 0 is the left board,
1 is the board snapped to its right). It then lights only the 24 notes that
belong on its own keys. A note for the other board stays dark here.

Until those control changes arrive, the hands stay blue and green. A theme
change updates keys that are already lit. CC 121 and CC 123 clear the notes
and leave the colours in place.

The lowest key is middle C until the octave buttons move it; the app sends
the new shared low note on CC 23. Touch, octave, and the notes the keys send
stay on the factory handler.
*/

const int keysPerBlock = 24;
const int midiNoteOff = 0x8;
const int midiNoteOn = 0x9;
const int midiCC = 0xB;
const int colorOff = 0xFF000000;

int baseNote;
int leftR;
int leftG;
int leftB;
int rightR;
int rightG;
int rightB;
int handFor[128];

int component(int value) {
    return (value * 255) / 127;
}

int handFromChannel(int channel) {
    if (channel == 1 || channel == 11) return 1;
    if (channel >= 2 && channel <= 5) return 1;
    if (channel == 6 || channel == 12) return 2;
    if (channel >= 7 && channel <= 10) return 2;
    return 0;
}

void clearNotes() {
    for (int i = 0; i < 128; i = i + 1) handFor[i] = 0;
}

void initialise() {
    // Factory handler keeps touch, octave buttons, and outgoing notes.
    setUseDefaultKeyHandler(true, false);
    baseNote = 60;
    leftR = 0;
    leftG = 0;
    leftB = 255;
    rightR = 0;
    rightG = 255;
    rightB = 0;
    clearNotes();
}

void handleMIDI(int byte0, int byte1, int byte2) {
    int channel = byte0 & 0x0F;
    int status = (byte0 >> 4) & 0x0F;

    if (status == midiCC) {
        if (byte1 == 123 || byte1 == 121) {
            clearNotes();
            return;
        }
        if (byte1 == 23 && (channel == 11 || channel == 12)) {
            baseNote = byte2;
            return;
        }
        if (byte1 >= 20 && byte1 <= 22 && (channel == 11 || channel == 12)) {
            int value = component(byte2);
            if (channel == 11) {
                if (byte1 == 20) leftR = value;
                if (byte1 == 21) leftG = value;
                if (byte1 == 22) leftB = value;
            } else {
                if (byte1 == 20) rightR = value;
                if (byte1 == 21) rightG = value;
                if (byte1 == 22) rightB = value;
            }
        }
        return;
    }

    if (byte1 < 0 || byte1 > 127) return;
    int hand = handFromChannel(channel);
    if (status == midiNoteOn && byte2 > 0) {
        if (hand != 0) handFor[byte1] = hand;
    } else if (status == midiNoteOff || (status == midiNoteOn && byte2 == 0)) {
        handFor[byte1] = 0;
    }
}

void repaint() {
    int left = makeARGB(255, leftR, leftG, leftB);
    int right = makeARGB(255, rightR, rightG, rightB);
    // Left-to-right DNA index. A lone board is 0, so it lights baseNote
    // through baseNote + 23, the same keys a single Piano M always used.
    int block = getClusterXpos();
    if (block < 0) {
        block = 0;
    }
    int origin = baseNote + block * keysPerBlock;
    for (int i = 0; i < keysPerBlock; i = i + 1) {
        int note = origin + i;
        int color = colorOff;
        if (note >= 0 && note < 128) {
            if (handFor[note] == 1) color = left;
            if (handFor[note] == 2) color = right;
        }
        fillPixel(color, i, 0);
    }
}
