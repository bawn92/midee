{
  "name": "piano-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node -e \"console.log('[postbuild] app only; marketing pages and icon regen are not run')\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:heavy": "E2E_HEAVY=1 playwright test",
    "test:e2e:report": "playwright show-report",
    "check": "npm run typecheck && npm run lint && npm run test",
    "icons": "node scripts/build-icons.mjs",
    "db:migrate": "node scripts/migrate-club.mjs",
    "bench": "npm run bench:build && node scripts/bench.mjs",
    "bench:build": "VITE_ENABLE_BENCH=1 npx vite build --outDir dist-bench",
    "bench:run": "node scripts/bench.mjs",
    "bench:real": "npm run bench:build && node scripts/bench.mjs --browser chrome,safari --suite exportreal",
    "bench:update": "npm run bench:build && node scripts/bench.mjs --update"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@clerk/backend": "^3.25.0",
    "@clerk/clerk-js": "^6.39.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/nunito-sans": "^5.3.0",
    "@mediabunny/aac-encoder": "^1.60.0",
    "@neondatabase/serverless": "^1.2.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tonaljs/chord": "^6.1.2",
    "@tonaljs/midi": "^4.10.2",
    "@tonejs/midi": "^2.0.28",
    "@tonejs/piano": "^0.2.1",
    "@vercel/analytics": "^2.0.1",
    "events": "^3.3.0",
    "mediabunny": "^1.60.0",
    "pixi-filters": "^6.0.1",
    "pixi.js": "^8.4.0",
    "solid-js": "^1.9.12",
    "tone": "^14.7.77",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@solidjs/testing-library": "^0.8.10",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^25.0.1",
    "playwright": "^1.59.1",
    "typescript": "^5.4.0",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.0"
  }
}
