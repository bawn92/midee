# Club stays on this device until these are set.
# Provision Clerk and Neon from the Vercel Marketplace, then:
#   npm run db:migrate

# Browser. A pk_test_ or pk_live_ key turns on sign-in. Google and Apple
# are enabled in the Clerk dashboard.
VITE_CLERK_PUBLISHABLE_KEY=

# Server only. Verifies the Clerk session on /api/club/*.
CLERK_SECRET_KEY=

# Neon Postgres connection string used by the API and npm run db:migrate.
DATABASE_URL=
