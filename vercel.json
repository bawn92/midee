{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), midi=(self), autoplay=(self), fullscreen=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://*.clerk.accounts.dev https://*.clerk.com https://accounts.google.com https://appleid.apple.com; script-src 'self' 'unsafe-eval' blob: https://*.clerk.accounts.dev https://*.clerk.com https://challenges.cloudflare.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://img.clerk.com https://images.clerk.dev https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://tambien.github.io/Piano/audio/ https://*.clerk.accounts.dev https://*.clerk.com https://api.clerk.com https://clerk-telemetry.com; worker-src 'self' blob:; media-src 'self' blob:; frame-src https://*.clerk.accounts.dev https://*.clerk.com https://challenges.cloudflare.com https://accounts.google.com https://appleid.apple.com"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/start/play", "destination": "/play", "permanent": false },
    { "source": "/start/play/", "destination": "/play", "permanent": false },
    { "source": "/start/live", "destination": "/live", "permanent": false },
    { "source": "/start/live/", "destination": "/live", "permanent": false },
    { "source": "/start/learn", "destination": "/learn", "permanent": false },
    { "source": "/start/learn/", "destination": "/learn", "permanent": false },
    { "source": "/start/learn/:song", "destination": "/learn/:song", "permanent": false },
    { "source": "/start/learn/:song/", "destination": "/learn/:song", "permanent": false },
    { "source": "/start/club", "destination": "/club", "permanent": false },
    { "source": "/start/club/", "destination": "/club", "permanent": false }
  ],
  "rewrites": [
    { "source": "/start", "destination": "/index.html" },
    { "source": "/start/", "destination": "/index.html" },
    { "source": "/welcome", "destination": "/index.html" },
    { "source": "/welcome/", "destination": "/index.html" },
    { "source": "/play", "destination": "/index.html" },
    { "source": "/play/", "destination": "/index.html" },
    { "source": "/live", "destination": "/index.html" },
    { "source": "/live/", "destination": "/index.html" },
    { "source": "/learn", "destination": "/index.html" },
    { "source": "/learn/", "destination": "/index.html" },
    { "source": "/learn/:song", "destination": "/index.html" },
    { "source": "/learn/:song/", "destination": "/index.html" },
    { "source": "/deadmau5", "destination": "/index.html" },
    { "source": "/deadmau5/", "destination": "/index.html" },
    { "source": "/club", "destination": "/index.html" },
    { "source": "/club/", "destination": "/index.html" },
    { "source": "/club/sso-callback", "destination": "/index.html" },
    { "source": "/club/sso-callback/", "destination": "/index.html" }
  ]
}
